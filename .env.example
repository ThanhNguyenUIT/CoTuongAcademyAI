# Local development defaults
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional. Set to a local UCI Xiangqi engine executable; do not commit the binary.
ENGINE_COMMAND=
ENGINE_COORDINATES=auto

# Optional Phase 4 tutor provider. Default `none` uses written hints without network calls.
APP_ENV=development
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional Phase 5 local learner history; data stays outside source control.
LEARNING_DB_PATH=.local-data/learning.sqlite3
LEARNING_REVIEW_INTERVALS_DAYS=1,3,7
